{
  "expo": {
    "name": "Saint Central",
    "slug": "saint-central",
    "version": "7.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prayer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.saintcentral.app",
      "buildNumber": "10",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.applesignin": ["Default"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saintcentral.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 216,
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE6",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#0F1A33"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "default"
        }
      ],
      [
        "@howincodes/expo-dynamic-app-icon",
        {
          "pink": {
            "ios": "./assets/images/icon-pink.png"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.saintcentral.app.widgets",
          "groupIdentifier": "group.com.saintcentral.app",
          "widgets": [
            {
              "name": "SharePrayerRequest",
              "displayName": "Share a prayer request",
              "description": "Share what's on your heart with Saint Central.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "initialLayout": "src/widgets/SharePrayerRequest.tsx"
              },
              "android": null
            },
            {
              "name": "PrayerStreakWidget",
              "displayName": "Prayer Streak",
              "description": "See your prayer streak and whether you've prayed today.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "src/widgets/PrayerStreakWidget.tsx"
              },
              "android": null
            },
            {
              "name": "QuietPrayerWidget",
              "displayName": "Quiet Prayer",
              "description": "Pause for a short prayer or open your prayer journal.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "src/widgets/QuietPrayerWidget.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1270163f-c338-455e-8c3a-2d27deefb16e"
      }
    }
  }
}
