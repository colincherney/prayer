EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public RevenueCat SDK keys. Expo Go uses Test Store only in development.
# Native iOS builds prefer the iOS key, including development builds.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
# The existing monthly Test Store product used to test Saint Central+.
EXPO_PUBLIC_REVENUECAT_TEST_PLUS_PRODUCT_ID=monthly_599
EXPO_PUBLIC_REVENUECAT_SUBSCRIPTION_OFFERING_ID=monthly_599
EXPO_PUBLIC_REVENUECAT_SUBSCRIPTION_ENTITLEMENT_ID=saint_central_app_pro
# Apple production / sandbox key; product: saintcentral_plus_monthly.
# Set this in EAS development, preview, and production environments too.
# Never put a test_ key in a platform key slot.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
